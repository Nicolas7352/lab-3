    {
        $adminRole = Role::create(['name' => 'admin']);
        $userRole  = Role::create(['name' => 'user']);

        $news = Category::create(['name' => 'Новости']);
        $tech = Category::create(['name' => 'Технологии']);

        $author = User::create([
            'name'     => 'Иван Иванов',
            'email'    => 'ivan@example.com',
            'login'    => 'ivan',
            'password' => bcrypt('secret'),
            'role_id'  => $userRole->id,
